# ============================================================================
#  MCPE bot (GenisysPro / LiteCore 1.1.5) - configuration
#  Copy to .env:  cp .env.example .env
# ============================================================================

# --- Telegram ---------------------------------------------------------------
# Token from @BotFather. The real value belongs in .env only (.env is ignored
# by git), so this example file stays safe to commit and to push to GitHub.
BOT_TOKEN=
# Recommended for public repos: keep the token outside the project entirely.
#   mkdir -p secrets && printf '%s' '<token>' > secrets/bot_token
#   BOT_TOKEN_FILE=/run/secrets/bot_token
BOT_TOKEN_FILE=
# Your Telegram numeric IDs (get them with /id in the bot or via @userinfobot)
ADMIN_IDS=
# true  -> anyone can create servers
# false -> only ADMIN_IDS
OPEN_FOR_EVERYONE=false

# --- server image / limits --------------------------------------------------
SERVER_IMAGE=genisyspro:litecore-1.1.5
# host   -> the container uses the host network (best for Bedrock UDP)
# bridge -> publishes <port>/udp through docker-proxy
SERVER_NETWORK_MODE=host
BIND_IP=0.0.0.0
SERVER_MEMORY_MB=1024
SERVER_CPU_LIMIT=1.0
PHP_MEMORY_LIMIT_MB=768
MAX_SERVERS_PER_USER=2

# --- ports ------------------------------------------------------------------
# UDP pool the bot allocates from (19132 is the default Minecraft PE port)
PORT_RANGE_START=19132
PORT_RANGE_END=19160

# --- how the public address is obtained -------------------------------------
# auto   -> UPnP -> NAT-PMP -> playit.gg (if PLAYIT_SECRET) -> direct public IP
# upnp / natpmp / playit / direct / manual
ADDRESS_MODE=auto
# Only for ADDRESS_MODE=manual (your domain or static IP, port optional)
PUBLIC_HOST=
# Lease for the router mapping; the bot refreshes it every minute,
# so the port closes by itself if the bot dies ("temporary address").
UPNP_LEASE_SECONDS=3600

# --- playit.gg (works behind CGNAT, no port forwarding needed) --------------
# 1) sign up at playit.gg, 2) create a "Minecraft Bedrock" tunnel to
# 127.0.0.1:19132, 3) paste the agent secret key here.
PLAYIT_SECRET=
PLAYIT_IMAGE=ghcr.io/playit-cloud/playit-agent:0.15

# --- lifetime ---------------------------------------------------------------
# Auto-stop a running server after N minutes and close its port (0 = never)
SERVER_TTL_MINUTES=240

# --- misc -------------------------------------------------------------------
DB_PATH=/data/bot.sqlite3
LOG_LEVEL=INFO
TZ=Asia/Chita
WORKER_THREADS=4
DEFAULT_MOTD=GenisysPro 1.1.5
DEFAULT_MAX_PLAYERS=20
DEFAULT_GAMEMODE=0
DEFAULT_DIFFICULTY=2

# --- build-time (PHP 7 runtime for the old PocketMine fork) -----------------
# PHP is compiled from php.net sources. 7.0 is mandatory: Genisys declares a
# class named Void and PHP 7.1+ rejects it ('Void' is a special class name).
PHP_VERSION=7.0.33
# pthreads tag from github.com/krakjoe/pthreads (v3.1.6 = last one for PHP 7.0)
PTHREADS_REF=v3.1.6
# pecl yaml version
YAML_VERSION=2.0.4
# Optional: skip compiling and use a ready tarball with a PHP 7.0 build
PHP_TARBALL_URL=
# Base images for the server build (stretch = last Debian with OpenSSL 1.0.2)
PHP_BUILD_IMAGE=debian:stretch
PHP_RUNTIME_IMAGE=debian:stretch-slim
